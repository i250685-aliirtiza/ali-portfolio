[Unit]
Description=Ali portfolio GitHub refresh
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ali-portfolio
Group=ali-portfolio
WorkingDirectory=/opt/ali-portfolio/current
EnvironmentFile=/etc/ali-portfolio.env
ExecStart=/opt/ali-portfolio/runtime/bin/node build/server/worker.js github
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ali-portfolio
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=192M
TasksMax=32
